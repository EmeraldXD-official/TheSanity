	CryoSniper: {
		Tooltip:
			'''
			Converts all bullets into high-velocity cryo rounds
			Striking an enemy marks them with a glacial target
			Hitting a marked enemy deals 30% bonus damage and detonates the mark into homing glacial shards
			Inflicts Frostbite on hit
			'''
		DisplayName: Cryo Sniper
	}

	DracolithX: {
		Tooltip:
			'''
			Converts all bullets into high-velocity draconic plasma rounds that inflict Hellfire
			Every 4th shot unleashes Thermal Overdrive, launching a massive piercing dragon head
			Overdrive shots deal 50% bonus damage and inflict Daybreak
			'''
		DisplayName: Dracolith X
	}

	XenodracX: {
		Tooltip:
			'''
			Converts all bullets into armor-piercing bio-organic rounds
			Ignores 20 points of enemy defense
			Striking enemies siphons life force to heal the wielder
			Upon impact, shatters into 3 bone shards affected by gravity
			Inflicts Venom on hit
			'''
		DisplayName: Xenodrac X
	}

	MoonlitBloom: {
		Tooltip:
			'''
			Luxurious slashes with cherry blossom particles
			Inflicts ShadowFlame on enemies upon hit by slashes or projectiles
			[Left Click]: Rapid three-slash combo chain
			Each slash releases flower petals from the blade tip
			Final combo hit releases a circular petal burst
			[Right Click]: Instant dash thrust stance, followed up by a finisher spin slash
			Grants temporary immunity during the dash thrust
			[Right Click Cooldown: 5 Seconds]
			'''
		DisplayName: Moonlit Bloom
	}

	ScarletDeath: {
		DisplayName: Scarlet Death
		Tooltip:
			'''
			[Left Click]: Unleashes a Cursed Bone Serpent Whip biting the Katana.
			Fires blood spatters launching straight toward your cursor.
			Blood spatters will home in on nearby enemies if present.
			[Right Click]: Cursed Sheath Parry. Parries enemy contact or projectiles.
			Successful parries grant invincibility and a +30% boost to All Weapon Stats!
			Inflicts 'Scarlet Laceration' and releases healing blood orbs on hit.
			'''
	}

	AmbariumOre: {
		Tooltip: Disguised as ordinary stone until the blood moon rises...
		DisplayName: Ambarium Ore
	}

	AmbariumBar: {
		Tooltip: A dense metal bar emitting shadowy energy.
		DisplayName: Ambarium Bar
	}

	AmbariumHook: {
		DisplayName: Ambarium Hook
		Tooltip: Reaches into the shadows to pull you forward.
	}

	AmbariumEye: {
		DisplayName: Ambarium Eye
		Tooltip:
			'''
			Throws a tethered ocular flail that can be aimed freely
			Shatters its chain shortly after thrown to aggressively charge toward nearby foes
			Inflicts Shadowflame on hit
			Inflicts Venom and Obstructed during a Blood Moon
			'''
	}

	AmbariumCodex: {
		Tooltip:
			'''
			Opens a dark rift at the cursor that launches a high-speed shadow orb
			The orb aggressively homes in on nearby targets with a fierce dash
			Explodes on impact into an exponentially expanding shockwave
			Inflicts Shadowflame on hit
			'''
		DisplayName: Ambarium Codex
	}

	AmbariumVisor: {
		DisplayName: Ambarium Visor
		Tooltip:
			'''
			Increases ranged damage by 4%
			Increases ranged critical strike chance by 6%
			'''
		SetBonus:
			'''
			20% chance to not consume ammo
			Every 8 ranged hits marks the strongest target for 5 seconds
			While active, shooting summons Shadow Clones that mirror your fire rate
			Has a 10 second recharge period after ending
			'''
	}

	AmbariumHood: {
		DisplayName: Ambarium Hood
		Tooltip:
			'''
			Increases magic damage by 4%
			Increases maximum mana by 40
			Reduces mana usage by 6%
			'''
		SetBonus:
			'''
			Casting spells builds Magic Power
			Every 5 spell casts triggers a Runic Supernova at cursor position, scattering homing shards
			'''
	}

	AmbariumMask: {
		DisplayName: Ambarium Mask
		Tooltip:
			'''
			Increases summon damage by 4%
			Increases max number of minions by 1
			'''
		SetBonus:
			'''
			Increases whip range by 15%
			Summons a floating Ambarium Sentinel above your head
			Minion and whip strikes charge the Sentinel to fire homing Shadowflame Shards
